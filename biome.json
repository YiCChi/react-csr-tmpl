{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "domains": {
      "project": "all",
      "react": "all",
      "test": "recommended"
    },
    "includes": ["**/*.ts", "**/*.tsx", "**/*.js"],
    "rules": {
      "recommended": true,
      "complexity": "error",
      "correctness": "error"
    }
  }
}
